{
  "name": "git-bbq-matt-skills",
  "version": "0.2.0",
  "private": true,
  "description": "US-English Matt Pocock skills maintained as a source repository for Git BBQ",
  "repository": {
    "type": "git",
    "url": "https://github.com/averyfreeman/git-bbq-matt-skills.git"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "audit:us-english": "node scripts/audit-us-english.mjs --check",
    "audit:us-english:report": "node scripts/audit-us-english.mjs --report reports/us-english-audit.md",
    "test:language": "node --test scripts/audit-us-english.test.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
